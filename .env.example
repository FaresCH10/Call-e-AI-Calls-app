# ===========================================================================
# Dial — environment template.  Copy to .env and fill in.  NEVER commit .env.
# Every value here is read by the SERVER (apps/api, apps/worker) only, except
# the few explicitly marked PUBLIC.
# ===========================================================================

# --- Call mode -------------------------------------------------------------
# "mock" -> FakeCallProvider. No real phone calls. Deterministic. For tests/dev.
# "real" -> CalleCallProvider. REAL phone calls are placed. Costs credits.
# "real" without CALLE_API_KEY throws at boot rather than silently faking.
TEST_PROVIDER=mock

# --- CALL-E (SERVER ONLY) --------------------------------------------------
# Key from https://dashboard.heycall-e.com/account/api-keys
# Must NEVER appear in browser JS or React Native bundles.
CALLE_API_KEY=
CALLE_BASE_URL=https://api.heycall-e.com
# Public HTTPS URL CALL-E can reach for terminal webhooks. Empty = polling only.
CALLE_WEBHOOK_URL=

# --- LLM (SERVER ONLY) -----------------------------------------------------
# Google Gemini API key, from https://aistudio.google.com/apikey
# Powers task interpretation. Server-side only; never shipped to a client.
LLM_API_KEY=
# Any Gemini model id. Popular models are frequently rate-limited, so the
# default is one that has proven consistently available rather than the newest.
LLM_MODEL=gemini-3.6-flash
# Tried in order when the primary is overloaded (comma-separated). This turns a
# provider-wide "try again later" into a slightly slower success.
LLM_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3-flash-preview,gemini-3.1-flash-lite,gemini-3.7-flash,gemini-3.5-flash
# Set to "1" to hard-fail at boot when LLM_API_KEY is absent.
LLM_REQUIRED=0

# --- Business discovery / search ------------------------------------------
# Provider order is resolved at boot from whichever keys are present.
# "osm" needs no key: OpenStreetMap Nominatim (geocoding) + Overpass (search).
# Required by Nominatim's usage policy — must identify this deployment.
OSM_CONTACT_EMAIL=
# Which directory Dial searches:
#   auto   - Google when a key is set, OpenStreetMap alongside it for a second
#            opinion on phone numbers (this is what lets a number be marked
#            verified). Falls back to OSM alone with no key.
#   google - Google only.
#   osm    - OpenStreetMap only.
DISCOVERY_PROVIDER=auto

# Google Maps. One key covers all three APIs, and all three must be enabled on
# the project with billing active:
#   - Places API (New)   business search
#   - Geocoding API      place name -> coordinates
#   - Time Zone API      only for country-sized places, to find a city to search
# Restrict the key by API, and by IP rather than by referrer: it is used
# server-side and never reaches the browser.
GOOGLE_PLACES_API_KEY=
# Generic web search for contact cross-verification (optional)
WEB_SEARCH_API_KEY=
WEB_SEARCH_PROVIDER=

# --- Database --------------------------------------------------------------
# Empty -> embedded PGlite (real Postgres compiled to WASM) at .pgdata/.
# Set to a real Postgres URL for production.
DATABASE_URL=

# --- Queue -----------------------------------------------------------------
# Empty -> durable Postgres-backed queue (FOR UPDATE SKIP LOCKED).
# Set to a Redis URL to use the BullMQ driver instead.
REDIS_URL=

# --- Server ----------------------------------------------------------------
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
# 32+ random bytes: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-me-with-a-long-random-string-at-least-32-chars
# Encrypts sensitive at-rest columns. Same generation command as above.
ENCRYPTION_KEY=replace-me-with-a-long-random-string-at-least-32-chars
CORS_ORIGINS=http://localhost:3000

# --- Cost & safety limits --------------------------------------------------
MAX_CALLS_PER_TASK=5
MAX_CALL_CONCURRENCY=3
MAX_CALLS_PER_USER_PER_DAY=25
CALL_WAVE_SIZE=3
# How long Dial waits on one attempt, and how many such waits before it gives up
# on a business and dials a different one. NOTE: this is Dial's patience, not a
# ring timeout -- CALL-E cannot cap ringing or cancel a call already in flight.
CALL_ANSWER_TIMEOUT_MS=30000
CALL_MAX_ATTEMPTS_PER_BUSINESS=2

# --- Web (apps/web) --------------------------------------------------------
# Server-side only: where the Next.js BFF proxy forwards to.
SERVER_API_URL=http://localhost:4000
PUBLIC_WEB_URL=http://localhost:3000

# --- Mobile (apps/mobile) — PUBLIC, shipped in the bundle -------------------
# Use your machine's LAN IP for a physical device, e.g. http://192.168.1.20:4000
EXPO_PUBLIC_API_URL=http://localhost:4000
